{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "dashboard",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["--filter", "@obs-demo/web", "run", "dev"],
			"port": 5173
		},
		{
			"name": "dashboard-review",
			"runtimeExecutable": "pnpm",
			"runtimeArgs": ["--filter", "@obs-demo/web", "run", "dev"],
			"port": 5174,
			"env": {
				"DEV_COLLECTOR_URL": "http://localhost:28790",
				"DEV_WEB_PORT": "5174"
			}
		},
		{
			"name": "docs",
			"runtimeExecutable": "bash",
			"runtimeArgs": ["-c", "cd ../obs-unified-docs && pnpm dev"],
			"port": 3000
		}
	]
}
