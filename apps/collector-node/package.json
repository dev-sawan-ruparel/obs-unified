{
	"name": "@obs-demo/collector-node",
	"private": true,
	"type": "module",
	"description": "Standalone Node.js entrypoint for @obs-unified/collector — Postgres + S3 backend, no Cloudflare Worker required.",
	"scripts": {
		"dev": "node --watch src/server.ts",
		"start": "node dist/server.js",
		"build": "tsup",
		"db:migrate": "node scripts/migrate-pg.mjs",
		"type-check": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.700.0",
		"@hono/node-server": "^1.13.7",
		"@obs-unified/collector": "workspace:*",
		"@obs-unified/telemetry-sdk": "workspace:*",
		"@obs-unified/types": "workspace:*",
		"hono": "^4.12.11",
		"pg": "^8.13.1"
	},
	"devDependencies": {
		"@types/node": "^25.5.2",
		"@types/pg": "^8.11.10",
		"tsup": "^8.3.5",
		"typescript": "^6.0.2"
	}
}
