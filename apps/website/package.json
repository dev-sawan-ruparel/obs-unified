{
	"name": "presence",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Landing page for Observability Unified, a self-hosted observability platform that gives AI agents context to debug production software.",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"packageManager": "pnpm@10.33.4",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build && tsx scripts/prerender-entry.ts",
		"preview": "vite preview",
		"types:check": "tsc --noEmit",
		"messaging:check": "node scripts/messaging-check.mjs",
		"comparison:check": "node scripts/comparison-check.mjs && tsx scripts/vendor-pages-check.ts",
		"deploy": "node ../../scripts/deploy-pages.mjs website",
		"deploy:preview": "node ../../scripts/deploy-pages.mjs website --preview"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3",
		"vite": "^5.4.10"
	}
}
