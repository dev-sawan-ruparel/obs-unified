# =============================================================================
# oauth2-proxy Configuration Environment File for obs-unified
# =============================================================================

# Server settings
OAUTH2_PROXY_HTTP_ADDRESS=0.0.0.0:4180
OAUTH2_PROXY_UPSTREAMS=static://202

# OIDC Provider Configuration
# Examples:
#   Google: https://accounts.google.com
#   Okta:   https://your-org.okta.com
#   Dex:    https://dex.internal.example.com
OAUTH2_PROXY_PROVIDER=oidc
OAUTH2_PROXY_OIDC_ISSUER_URL=https://accounts.google.com
OAUTH2_PROXY_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com
OAUTH2_PROXY_CLIENT_SECRET=replace-with-your-client-secret

# Cookie Configuration
# Generate cookie secret with: python3 -c 'import os,base64; print(base64.b64encode(os.urandom(32)).decode())'
OAUTH2_PROXY_COOKIE_SECRET=replace-with-generated-32-byte-base64-string==
OAUTH2_PROXY_COOKIE_NAME=_oauth2_proxy
OAUTH2_PROXY_COOKIE_SECURE=true
OAUTH2_PROXY_COOKIE_HTTPONLY=true
OAUTH2_PROXY_COOKIE_SAMESITE=lax
OAUTH2_PROXY_COOKIE_EXPIRE=168h

# Authorization Restrictions
# Restrict to your company email domain
OAUTH2_PROXY_EMAIL_DOMAINS=company.com

# Header Passing
OAUTH2_PROXY_PASS_USER_HEADERS=true
OAUTH2_PROXY_SET_XAUTHREQUEST=true

# Public Route Bypass
# Ensures telemetry ingest and health checks are not redirected to OAuth login
OAUTH2_PROXY_SKIP_AUTH_ROUTES=^/health$,^/v1/.*
