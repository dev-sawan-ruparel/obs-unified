{
	"name": "@obsunified/agents-langgraph",
	"version": "2.0.2",
	"description": "LangGraph/LangChain framework wrapper for obs-unified Agent Action Graph",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsup",
		"type-check": "tsc --noEmit",
		"test": "vitest run --passWithNoTests"
	},
	"dependencies": {},
	"peerDependencies": {
		"@obsunified/telemetry-sdk": "workspace:*"
	},
	"devDependencies": {
		"@obsunified/telemetry-sdk": "workspace:*",
		"tsup": "^8.3.5",
		"typescript": "^6.0.2",
		"vitest": "^4.1.2"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
