# Copied to .env.local at scaffold time. The frontend reads VITE_* vars;
# the Hono API (`pnpm dev:api`) loads this same file via
# `tsx --env-file-if-exists=.env.local` and reads the non-VITE_ vars.
# Replace dev-ingest-key with a real key (`obs-unified keys mint`) if the
# collector enforces ingest keys.

VITE_OBS_COLLECTOR_URL=__COLLECTOR_URL__
VITE_OBS_INGEST_KEY=__INGEST_KEY__

# Server-side (Hono / Node):
OBS_COLLECTOR_URL=__COLLECTOR_URL__
OBS_INGEST_KEY=__INGEST_KEY__
