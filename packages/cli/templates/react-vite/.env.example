# Copy to .env.local and fill in. The frontend reads VITE_* vars at
# build time. Server-side vars live alongside but without the VITE_
# prefix.

VITE_OBS_COLLECTOR_URL=__COLLECTOR_URL__
VITE_OBS_INGEST_KEY=dev-ingest-key

# Server-side (Hono / Node):
OBS_COLLECTOR_URL=__COLLECTOR_URL__
OBS_INGEST_KEY=dev-ingest-key
