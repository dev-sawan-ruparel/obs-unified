{
	"name": "@obsunified/telemetry-sdk",
	"version": "2.0.2",
	"description": "Server-side telemetry SDK — OTLP spans, structured logger, AI/LLM helpers, interaction_id stamping. Workers wrappers under ./cloudflare.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/obs-unified/obs-unified.git",
		"directory": "packages/telemetry-sdk"
	},
	"keywords": [
		"observability",
		"opentelemetry",
		"otel",
		"openinference",
		"llm",
		"cloudflare-workers",
		"obs-unified"
	],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./cloudflare": {
			"types": "./dist/cloudflare.d.ts",
			"import": "./dist/cloudflare.js"
		},
		"./agent": {
			"types": "./dist/agent.d.ts",
			"import": "./dist/agent.js"
		},
		"./agent-plugin": {
			"types": "./dist/agent-plugin.d.ts",
			"import": "./dist/agent-plugin.js"
		},
		"./mcp": {
			"types": "./dist/mcp.d.ts",
			"import": "./dist/mcp.js"
		}
	},
	"files": [
		"dist",
		"src",
		"README.md",
		"INSTRUMENTATION_GUIDE.md"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsup",
		"type-check": "tsc --noEmit",
		"test": "vitest run --passWithNoTests",
		"prepublishOnly": "pnpm build"
	},
	"dependencies": {
		"@obsunified/types": "workspace:*",
		"@opentelemetry/api": "^1.9.0"
	},
	"peerDependencies": {
		"@hono/otel": "^1.0.0",
		"@microlabs/otel-cf-workers": "^1.0.0-rc.40",
		"hono": "^4.7.0"
	},
	"peerDependenciesMeta": {
		"@hono/otel": {
			"optional": true
		},
		"@microlabs/otel-cf-workers": {
			"optional": true
		},
		"hono": {
			"optional": true
		}
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20260405.1",
		"hono": "^4.12.11",
		"tsup": "^8.3.5",
		"typescript": "^6.0.2"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
